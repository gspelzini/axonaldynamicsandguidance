import numpy as np
import matplotlib.pyplot as plt
# -------------------------------------------------------
# 1)  DATOS
# -------------------------------------------------------
theta_degrees = [
    21.63, 19.43, -8.37, -60.77, -45.98, 30.85, 76.19, 24.41, -55.30, -21.00, 5.52, 28.42, -23.24, -8.80, -3.14, -7.59, 6.61, 51.35, 32.81, 14.59, 31.34, 18.92, 32.52, 32.36, 57.78, 44.29  
]
# -------------------------------------------------------
# 2)  BORDES CADA 10°  (de –90° a 180°)
# -------------------------------------------------------
edges_deg = np.arange(-90, 181, 10)          # -90, -80, …, 180
edges_rad = np.deg2rad(edges_deg)
counts, _ = np.histogram(theta_degrees, bins=edges_deg)
# -------------------------------------------------------
# 3)  FIGURA POLAR
# -------------------------------------------------------
fig, ax = plt.subplots(figsize=(6, 6), subplot_kw={'projection': 'polar'})
ax.bar(edges_rad[:-1], counts,
       width=np.deg2rad(10), align='edge',
       color='#AA4499', edgecolor='black', linewidth=1.0, alpha=0.9)
# -------------------------------------------------------
# 4)  ORIENTACIÓN 0° ARRIBA, SENTIDO HORARIO
# -------------------------------------------------------
ax.set_theta_direction(-1)
ax.set_theta_offset(np.pi/2.0)
tick_deg = np.arange(0, 360, 30)
ax.set_xticks(np.deg2rad(tick_deg))
ax.set_xticklabels([f'{d}°' if d <= 180 else f'-{360-d}°' for d in tick_deg])
# -------------------------------------------------------
# 5)  EXPORTAR
# -------------------------------------------------------
fig.set_dpi(300)
plt.savefig('rosadevientos_UPA.png',  dpi=300, bbox_inches='tight')
plt.savefig('rosadevientos_UPA.tiff', dpi=300, bbox_inches='tight')
plt.show()
