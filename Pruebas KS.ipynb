   "source": [
    "import pandas as pd\n",
    "from scipy.stats import ks_2samp\n",
    "\n",
    "# Lee usando sep=';'\n",
    "df = pd.read_csv(\"PRUEBAS KS.csv\", sep=';')\n",
    "\n",
    "print(df.columns.tolist())\n",
    "# ahora verás: ['Control', 'EphA3']\n",
    "\n",
    "control = df['Control'].dropna()\n",
    "epha3   = df['EphA3'].dropna()\n",
    "\n",
    "D, p = ks_2samp(Control, EphA3)\n",
    "\n",
    "# 2) Extrae las dos muestras\n",
    "Control  = df['Control'].dropna()\n",
    "EphA3  = df['EphA3'].dropna()\n",
    "\n",
    "# 3) Ejecuta el KS de dos muestras\n",
    "D, p_value = ks_2samp(Control, EphA3)\n",
    "print(f\"Kolmogorov-Smirnov: D = {D:.3f}, p = {p_value:.4f}\")\n",
    "\n",
    "\n"
   ]
  },
