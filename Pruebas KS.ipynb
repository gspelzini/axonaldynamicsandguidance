import pandas as pd
from scipy.stats import ks_2samp

df = pd.read_excel("PRUEBAS KS EphA3_EphA3kyl.xlsx")

# Quitar espacios y reemplazar espacios internos por guiones bajos
df.columns = df.columns.str.strip().str.replace(" ", "_")

print(df.columns.tolist())

EphA3Fc = pd.to_numeric(df["EphA3Fc"], errors="coerce").dropna()
EphA3FcKYL = pd.to_numeric(df["EphA3FcKYL"], errors="coerce").dropna()

D, p = ks_2samp(EphA3Fc, EphA3FcKYL)

print(f"K–S D = {D:.3f}, p = {p:.8f}")
